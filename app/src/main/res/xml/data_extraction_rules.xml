<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup=false (spec §11): personal data and logs (which may hold decrypted
  contents) must never leave the device via cloud/adb backup. These rules exclude
  everything as defense-in-depth.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
