<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Embedded web server foreground service (spec §8/§9). -->
        <service
            android:name="com.ismartcoding.plain.webserver.HttpServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local LAN web console for managing this device from a browser" />
        </service>

        <!-- Notification mirroring (user-granted binding). -->
        <service
            android:name="com.ismartcoding.plain.features.notification.MwiNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Screen-mirror capture (MediaProjection). -->
        <service
            android:name="com.ismartcoding.plain.features.screenmirror.ScreenMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Remote control via accessibility (user-granted binding). -->
        <service
            android:name="com.ismartcoding.plain.features.screenmirror.MwiAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Quick Settings tile to toggle the web server. -->
        <service
            android:name="com.ismartcoding.plain.webserver.WebServerTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_web"
            android:label="MWI Web"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The Audio (Media3) foreground service and token-guarded start/stop receiver are declared
             as later phases land. -->
    </application>
</manifest>
