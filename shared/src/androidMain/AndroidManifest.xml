<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Embedded web server foreground service (spec §8/§9). -->
        <service
            android:name="com.ismartcoding.plain.webserver.HttpServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local LAN web console for managing this device from a browser" />
        </service>

        <!-- Notification mirroring (user-granted binding). -->
        <service
            android:name="com.ismartcoding.plain.features.notification.MwiNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Additional services (Audio / ScreenMirror / Accessibility / QSTile) and the
             token-guarded start/stop receiver are declared as later phases land. -->
    </application>
</manifest>
